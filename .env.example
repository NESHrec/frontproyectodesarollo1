# URL base pública (no secreta) del API de Clínica Serena.
# Copia este archivo a .env.local y ajusta el valor para tu entorno.
BACKEND_API_BASE_URL=http://localhost:8080/api/v1
# Debe reemplazarse por un valor aleatorio de 32+ caracteres. CHANGE_ME hace
# que el BFF ignore forwarded headers (fail closed).
TRUSTED_PROXY_SHARED_SECRET=CHANGE_ME
