# URL base pública (no secreta) del API de Clínica Serena.
# Copia este archivo a .env.local y ajusta el valor para tu entorno.
BACKEND_API_BASE_URL=http://localhost:8080/api/v1

# Sentry: completar solo en el entorno seguro; no guardar secretos en el repositorio.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0
# Solo CI, nunca en .env.local ni en el chat.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
